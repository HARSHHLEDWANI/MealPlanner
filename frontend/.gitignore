# Dependencies
node_modules/

# Environment
# Anything prefixed VITE_ is inlined into the public bundle. Real values
# never belong in git regardless — put placeholders in .env.example.
.env
.env.*
!.env.example

# Build output
dist/
build/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
