# Copy to .env and fill in real values. Never commit .env.
#
# WARNING: every VITE_-prefixed variable is inlined into the JavaScript
# bundle and is readable by anyone who loads the site. Only publishable
# values belong in this file. Secrets (service-role keys, LLM API keys)
# go in backend/.env, which is never shipped to a browser.

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key. Safe to ship only because row-level
# security constrains what it can reach.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Base URL of the Express API. Must match the backend's PORT.
VITE_API_URL=http://localhost:5001
