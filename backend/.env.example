# Copy to .env and fill in real values. Never commit .env.
# Every value in this file is secret and server-only.

# Port the API listens on. The frontend's VITE_API_URL must match.
PORT=5001

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service-role key. HIGHLY SENSITIVE: it bypasses all row-level security.
# Server-side only — never expose it to a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google AI Studio key for Gemini. Metered and billable — every
# /api/ai/* request spends against it.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to gemini-1.5-flash; gemini-1.5-pro is slower,
# pricier, and higher quality.
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Per-user daily cap on AI generation calls (Phase 5).
AI_DAILY_QUOTA=50
